# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=inventory_db

# ── Backend ──────────────────────────────────────────────────────────────────
# Full URL used by the backend container (uses service name 'db')
DATABASE_URL=postgresql://postgres:changeme_in_production@db:5432/inventory_db

# ── Frontend ─────────────────────────────────────────────────────────────────
# The public URL of your backend (change to deployed URL in production)
VITE_API_URL=http://localhost:8000
